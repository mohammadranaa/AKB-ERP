# Copy to .env and change every password before real use.
POSTGRES_PASSWORD=change-me-superuser
AKB_OWNER_PASSWORD=change-me-owner
AKB_APP_PASSWORD=change-me-app

# Used by the API when you run it outside Docker (pnpm dev:api)
DATABASE_URL=postgres://akb_app:change-me-app@localhost:5432/akb
MIGRATION_DATABASE_URL=postgres://akb_owner:change-me-owner@localhost:5432/akb

# true = every user must use an authenticator app. Keep true for real data.
REQUIRE_TOTP=false
TIMEZONE=Asia/Karachi
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
