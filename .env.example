# Copy to .env and change every password before real use.
# Use letters and numbers only in these passwords (no @ : / ' or spaces).
POSTGRES_PASSWORD=changeMeSuperuser1
AKB_OWNER_PASSWORD=changeMeOwner1
AKB_APP_PASSWORD=changeMeApp1

# development = demo data allowed. production = demo data refused and authenticator always required.
NODE_ENV=development

# true = every user must use an authenticator app (Google Authenticator, Microsoft Authenticator...).
# Keep true for real data. false is only for trying the system with demo data.
REQUIRE_TOTP=false
TIMEZONE=Asia/Karachi

# 127.0.0.1 = only this laptop can open the system. 0.0.0.0 = other computers on the same network can too.
WEB_BIND=127.0.0.1
DB_PORT=5432

# Used when running without Docker (tools/mac-setup.sh, pnpm dev:api).
DATABASE_URL=postgres://akb_app:changeMeApp1@localhost:5432/akb
MIGRATION_DATABASE_URL=postgres://akb_owner:changeMeOwner1@localhost:5432/akb
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
